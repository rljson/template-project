{
  "extends": "./tsconfig.workspace.json",
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "module": "NodeNext",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Distribution */
    /* The sibling repos of a gg ticket join the program through the paths
       of tsconfig.workspace.json. TypeScript 6 defaults rootDir to the
       project folder and reports TS6059 for every file outside it. */
    "rootDir": "../..",
    "outDir": "dist/",
    "declaration": true,
    "noEmitOnError": true,
    "emitDeclarationOnly": false,
    "esModuleInterop": true,
    "noEmit": true,

    /* Bundler mode */
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    /** Json modules **/
    "resolveJsonModule": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["./src/"]
}
